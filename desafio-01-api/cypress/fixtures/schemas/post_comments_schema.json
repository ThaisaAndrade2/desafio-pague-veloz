{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Comment",
  "description": "Schema para a estrutura de um comentário de postagem",
  "type": "object",
  "properties": {
    "postId": {
      "type": "number"
    },
    "id": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email" 
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "postId",
    "id",
    "name",
    "email",
    "body"
  ]
}